            machinePathExpandedLength        = if ($powerShellPathDiagnostics) { $powerShellPathDiagnostics.MachinePath.ExpandedLength } else { $null }
            machinePathEmptyEntryCount       = if ($powerShellPathDiagnostics) { $powerShellPathDiagnostics.EmptyEntryCount } else { $null }
            pathExtContainsExe               = if ($powerShellPathDiagnostics) { [bool]$powerShellPathDiagnostics.PathExtHasExe } else { $null }
            pathExtEffective                 = if ($powerShellPathDiagnostics) { $powerShellPathDiagnostics.EffectivePathExt } else { $null }
            powerShellExecutionProbeRun      = if ($powerShellExecutionProbeResult) { $true } else { $false }
            powerShellExecutionProbeSucceeded = if ($powerShellExecutionProbeResult) { [bool]$powerShellExecutionProbeResult.Succeeded } else { $null }
            powerShellExecutionProbeVerdict  = if ($powerShellExecutionProbeResult) { $powerShellExecutionProbeResult.Interpretation } else { $null }
            powerShellPathRepairAttempted    = [bool]$powerShellPathRepairAttempted
            powerShellPathRepairSucceeded    = [bool]$powerShellPathRepairSucceeded
            powerShellPathEntriesAdded       = @($powerShellPathEntriesAdded)
            powerShellPathValueKindCorrected = [bool]$powerShellPathValueKindCorrected
            pathExtRepairApplied             = [bool]$pathExtRepairApplied
            powerShellPathBackupFile         = $powerShellPathBackupFile
            pathExtBackupFile                = $pathExtBackupFile
            powerShellPathServiceOverrideApplied = [bool]$powerShellPathServiceOverrideApplied
            powerShellPathServicesRestarted  = $powerShellPathServicesRestarted
            powerShellPathRebootRecommended  = [bool]$powerShellPathRebootRecommended
            powerShellPathPostRepairStatus   = $powerShellPathPostRepairStatus
            failOnPowerShellPathUnrepairable = [bool]$FailOnPowerShellPathUnrepairable

            summaryReason               = $Reason
            deploymentPath              = 'MSI (standard agent path)'
            transcriptPath              = $script:TranscriptPath
            installerLogPath            = $logPath
            warnings                    = (ConvertTo-SafeArray $summaryWarnings)
        }

        $summary | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $script:SummaryArtifactPath -Encoding UTF8
        $script:RunSummaryWritten = $true
        Write-Host "JSON run summary written to [$script:SummaryArtifactPath]."
    }
    catch {
        Write-Warning "Failed to write MSI JSON run summary: $($_.Exception.Message)"
    }
}

function Exit-MsiRun {
    # Phase 2: single terminal helper. Records the standardized script exit code, writes the
    # JSON summary + a final exit-summary log line, stops the transcript, and exits with the
    # standardized code. Does NOT change install/skip decisions — only how the exit is expressed.
    #
    # Phase 7 addition: when a PATH repair was applied but could not be delivered to the service
    # (no override written AND no restart), a successful exit may be escalated to 2
    # ('Success, reboot required'). This is OPT-IN via $EscalateExitCodeWhenPathRepairNeedsReboot
    # and defaults to off, so existing exit-code behavior is unchanged unless enabled.
    param(
        [Parameter(Mandatory)][int]$Code,
        [string]$Reason
    )

    if ($EscalateExitCodeWhenPathRepairNeedsReboot -and $Code -eq 0 -and $powerShellPathRebootRecommended) {
        Write-Warning "[PSPath] A PATH repair was applied but could not be delivered to the agent service without a reboot; escalating exit 0 -> 2 (Success, reboot required)."
        $Code = 2
    }

    $script:ScriptExitCode = $Code
    $meaning = Get-ScriptExitCodeMeaning -Code $Code
    Write-MsiRunSummary -Reason $Reason
    $rawCode = if ($null -ne $msiExitCode) { $msiExitCode } else { $exitCode }
    Write-Host ("[Exit][SUMMARY] FinalStatus='{0}'; ScriptExitCode={1}; Meaning='{2}'; RawInstallerExitCode={3}; RebootRequired={4}" -f $finalStatus, $Code, $meaning, $rawCode, ($Code -eq 2))
    Stop-LiongardTranscript
    exit $Code
}

# ================================
# Main
# ================================

# ================================
# Phase 6 - Advisory environment / device validation (read-only, best-effort)
# Determines whether this device already appears in Liongard and, if so, whether its agent
# record's environment matches the one this run targets. Advisory by default; never blocks,
# re-registers, or modifies any record. Mirrors the uninstall script's matching model.
# ================================
function Get-ObjectPropertyValue {
    param([Parameter()][object]$Object, [Parameter()][string]$Name, [Parameter()][object]$Default = $null)
    if ($null -eq $Object -or [string]::IsNullOrEmpty($Name)) { return $Default }
    $property = $Object.PSObject.Properties[$Name]
    if ($null -eq $property) { return $Default }
    return $property.Value
}

function Normalize-GuidString {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return $null }
    return $Value.Trim('{}').Trim().ToLowerInvariant()
}

function Normalize-MacAddress {
    param([string]$Value)
    if ([string]::IsNullOrWhiteSpace($Value)) { return $null }
    $clean = ($Value -replace '[^0-9a-fA-F]', '').ToUpperInvariant()
    if ($clean.Length -lt 12) { return $null }
    return $clean.Substring(0, 12)
}

function Get-AgentHostIdentifiers {
    param([Parameter(Mandatory)] $Agent)
    $candidates = @()
    if (-not [string]::IsNullOrWhiteSpace($Agent.Hostname)) { $candidates += $Agent.Hostname }
    if (-not [string]::IsNullOrWhiteSpace($Agent.Name)) { $candidates += $Agent.Name }
    if ($Agent.PSObject.Properties.Match('Data').Count -gt 0) {
        $fqdn = $Agent.Data.FQDN
        if (-not [string]::IsNullOrWhiteSpace($fqdn)) { $candidates += $fqdn }
    }
    $variants = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::InvariantCultureIgnoreCase)
    foreach ($candidate in ($candidates | Sort-Object -Unique)) {
        if (-not [string]::IsNullOrWhiteSpace($candidate)) {
            $variants.Add($candidate) | Out-Null
            if ($candidate.Length -gt 15) { $variants.Add($candidate.Substring(0, 15)) | Out-Null }
        }
    }
    return (ConvertTo-SafeArray $variants)
}

function Get-AgentMacAddresses {
    param($Agent)
    $set = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
    if (-not $Agent) { return $set }
    if ($Agent.PSObject.Properties.Match('Data').Count -eq 0) { return $set }
    $data = $Agent.Data
    foreach ($key in @('MACAddress','MacAddress','MACAddresses','Mac','Macs')) {
        $prop = $data.PSObject.Properties[$key]
        if (-not $prop) { continue }
        $raw = $prop.Value
        if ($null -eq $raw) { continue }
        if ($raw -is [System.Collections.IEnumerable] -and -not ($raw -is [string])) {
            foreach ($entry in $raw) { $mac = Normalize-MacAddress -Value $entry; if ($mac) { $set.Add($mac) | Out-Null } }
            continue
        }
        foreach ($part in (($raw -split '[,; ]') | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })) {
            $mac = Normalize-MacAddress -Value $part; if ($mac) { $set.Add($mac) | Out-Null }
        }
    }
    return $set
}

function Get-AgentEnvironmentValue {
    # Liongard agent records expose Environment as a nested object ({ ID, Name, ShortName, ... }).
    # Tolerate a bare string/id too. Returns @{ Name; Id } or $null when not present.
    param($Agent)
    $env = Get-ObjectPropertyValue -Object $Agent -Name 'Environment'
    if ($null -eq $env) { return $null }
    if ($env -is [string]) {
        if ([string]::IsNullOrWhiteSpace($env)) { return $null }
        return [pscustomobject]@{ Name = $env; Id = $null }
    }
    if ($env -is [int] -or $env -is [long]) {
        return [pscustomobject]@{ Name = $null; Id = [string]$env }
    }
    $name = Get-ObjectPropertyValue -Object $env -Name 'Name'
    if ([string]::IsNullOrWhiteSpace($name)) { $name = Get-ObjectPropertyValue -Object $env -Name 'DisplayName' }
    $id = Get-ObjectPropertyValue -Object $env -Name 'ID'
    if ($null -eq $id) { $id = Get-ObjectPropertyValue -Object $env -Name 'EnvironmentID' }
    if ([string]::IsNullOrWhiteSpace($name) -and ($null -eq $id)) { return $null }
    return [pscustomobject]@{ Name = $name; Id = $(if ($null -ne $id) { [string]$id } else { $null }) }
}

function Invoke-EnvironmentDeviceValidation {
    # Best-effort, read-only. Queries /api/v1/agents by MachineGuid (mirrors the uninstall
    # lookup), scores the match (MachineGuid 100, MAC +40, hostname +30), extracts the matched
    # agent's environment, and compares it to the expected (resolved) environment. Never throws.
    param(
        [string]$InstancePrefix,
        [hashtable]$Headers,
        [Parameter(Mandatory)] $DeviceIdentity,
        [string]$ExpectedEnvironment,
        [int]$HighConfidenceThreshold = 100
    )

    $warnings = New-Object System.Collections.Generic.List[string]
    $result = [pscustomobject]@{
        Status                 = 'Skipped'
        ApiAvailable           = $false
        ConfidenceScore        = 0
        ConfidenceLevel        = 'None'
        MatchedAgentId         = $null
        MatchedAgentName       = $null
        MatchedEnvironment     = $null
        ExpectedEnvironment    = $ExpectedEnvironment
        MatchSignals           = @()
        Mismatch               = $false
        HighConfidenceMismatch = $false
        Warnings               = @()
    }

    if (-not $InstancePrefix -or -not $Headers) {
        $warnings.Add('Liongard API context unavailable; environment/device validation skipped.') | Out-Null
        $result.Status = 'Skipped'; $result.Warnings = (ConvertTo-SafeArray $warnings); return $result
    }

    $machineGuid = Normalize-GuidString -Value $DeviceIdentity.MachineGuid
    if (-not $machineGuid) {
        $warnings.Add('Local MachineGuid unavailable; advisory device match skipped (conservative).') | Out-Null
        $result.Status = 'Skipped'; $result.Warnings = (ConvertTo-SafeArray $warnings); return $result
    }

    $escapedGuid = $DeviceIdentity.MachineGuid -replace "'", "''"
    $encoded = [Uri]::EscapeDataString("MachineGuid = '$escapedGuid'")
    $uri = "https://$InstancePrefix.app.liongard.com/api/v1/agents?conditions=$encoded"

    try {
        $response = Invoke-RestMethod -Uri $uri -Headers $Headers -ErrorAction Stop
        $result.ApiAvailable = $true
    }
    catch {
        $warnings.Add("Liongard agent lookup failed (validation treated as Unavailable): $($_.Exception.Message)") | Out-Null
        $result.Status = 'Unavailable'; $result.Warnings = (ConvertTo-SafeArray $warnings); return $result
    }

    $agents = @()
    if ($null -ne $response) { if ($response -is [System.Array]) { $agents = $response } else { $agents = @($response) } }
    $agents = @($agents | Where-Object { $_ })
    if ($agents.Count -eq 0) {
        $result.Status = 'NoLikelyMatch'; $result.Warnings = (ConvertTo-SafeArray $warnings); return $result
    }

    $localMacs = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
    foreach ($m in @($DeviceIdentity.MacAddresses)) { $nm = Normalize-MacAddress -Value $m; if ($nm) { $localMacs.Add($nm) | Out-Null } }
    $localNames = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::InvariantCultureIgnoreCase)
    foreach ($n in @($DeviceIdentity.NetbiosName, $DeviceIdentity.Hostname, $DeviceIdentity.Fqdn)) {
        if (-not [string]::IsNullOrWhiteSpace($n)) {
            $localNames.Add($n) | Out-Null
            if ($n.Length -gt 15) { $localNames.Add($n.Substring(0, 15)) | Out-Null }
        }
    }

    $candidates = @()
    foreach ($agent in $agents) {
        # Verify the MachineGuid CLIENT-SIDE rather than trusting the server-side conditions filter.
        # Only credit the 100-point MachineGuid match when the returned record's own MachineGuid
        # matches the local one. This prevents a false high-confidence match (and a false strict-mode
        # block) if the API ever ignores the conditions filter and returns unrelated/all agents.
        $score = 0
        $signals = @()
        $agentGuid = Normalize-GuidString -Value (Get-ObjectPropertyValue -Object $agent -Name 'MachineGuid')
        if (-not $agentGuid -and ($agent.PSObject.Properties.Match('Data').Count -gt 0)) {
            $agentGuid = Normalize-GuidString -Value (Get-ObjectPropertyValue -Object $agent.Data -Name 'MachineGuid')
        }
        if ($agentGuid) {
            if ($agentGuid -eq $machineGuid) { $score += 100; $signals += 'MachineGuid' }
        }
        else {
            $warnings.Add('Agent record did not expose MachineGuid; server-side MachineGuid filter could not be verified client-side (match relies on MAC/hostname only).') | Out-Null
        }
        $nameMatches = @((Get-AgentHostIdentifiers -Agent $agent) | Where-Object { $localNames.Contains($_) })
        if ($nameMatches.Count -gt 0) { $score += 30 + [Math]::Min(15, 5 * ($nameMatches.Count - 1)); $signals += 'Hostname' }
        $macMatches = @((Get-AgentMacAddresses -Agent $agent) | Where-Object { $localMacs.Contains($_) })
        if ($macMatches.Count -gt 0) { $score += 40 + [Math]::Min(10, 5 * ($macMatches.Count - 1)); $signals += 'MAC' }
        $agentEnv = Get-AgentEnvironmentValue -Agent $agent
        $candidates += [pscustomobject]@{ Agent = $agent; Score = $score; Signals = $signals; Env = $agentEnv }
    }

    # Only retain candidates with at least one client-verified signal. If the server filter was
    # ignored and nothing matches locally, treat as no likely match (never a false block).
    $candidates = @($candidates | Where-Object { $_.Score -gt 0 })
    if ($candidates.Count -eq 0) {
        $result.Status = 'NoLikelyMatch'; $result.Warnings = (ConvertTo-SafeArray $warnings); return $result
    }

    $best = ($candidates | Sort-Object Score -Descending | Select-Object -First 1)
    $result.ConfidenceScore = $best.Score
    $result.MatchSignals = @($best.Signals)
    $result.MatchedAgentId = Get-ObjectPropertyValue -Object $best.Agent -Name 'ID'
    $result.MatchedAgentName = Get-ObjectPropertyValue -Object $best.Agent -Name 'Name'
    $result.ConfidenceLevel = if ($best.Score -ge 100) { 'High' } elseif ($best.Score -ge 70) { 'Medium' } else { 'Low' }

    $bestEnv = $best.Env
    $result.MatchedEnvironment = if ($bestEnv) { if ($bestEnv.Name) { $bestEnv.Name } elseif ($bestEnv.Id) { "ID:$($bestEnv.Id)" } else { $null } } else { $null }

    if ($candidates.Count -gt 1) {
        $distinctEnvs = @($candidates | ForEach-Object { if ($_.Env -and $_.Env.Name) { (Normalize-EnvironmentName -Value $_.Env.Name) } else { $null } } | Where-Object { $_ } | Select-Object -Unique)
        if ($distinctEnvs.Count -gt 1) {
            $warnings.Add(("Multiple Liongard agents matched this MachineGuid with differing environments ({0})." -f $candidates.Count)) | Out-Null
            $result.Status = 'MultiplePossibleMatches'; $result.Warnings = (ConvertTo-SafeArray $warnings); return $result
        }
    }

    if (-not $bestEnv -or (-not $bestEnv.Name -and -not $bestEnv.Id)) {
        $result.Status = 'MatchedEnvironmentUnknown'; $result.Warnings = (ConvertTo-SafeArray $warnings); return $result
    }
    if ([string]::IsNullOrWhiteSpace($ExpectedEnvironment) -or [string]::IsNullOrWhiteSpace($bestEnv.Name)) {
        $warnings.Add('Matched-environment name comparison was not possible (expected or matched name unavailable).') | Out-Null
        $result.Status = 'MatchedEnvironmentUnknown'; $result.Warnings = (ConvertTo-SafeArray $warnings); return $result
    }

    $expectedNorm = Normalize-EnvironmentName -Value $ExpectedEnvironment
    $matchedNorm = Normalize-EnvironmentName -Value $bestEnv.Name
    if ($matchedNorm -and $expectedNorm -and $matchedNorm -eq $expectedNorm) {
        $result.Status = 'MatchedExpectedEnvironment'
    }
    elseif ($matchedNorm) {
        $result.Status = 'MatchedDifferentEnvironment'
        $result.Mismatch = $true
        $result.HighConfidenceMismatch = ($best.Score -ge $HighConfidenceThreshold)
    }
    else {
        $result.Status = 'MatchedEnvironmentUnknown'
    }

    $result.Warnings = (ConvertTo-SafeArray $warnings)
    return $result
}

[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.SecurityProtocolType]::Tls12

Start-LiongardTranscript -TargetFolder $Folder

# Phase 1 read-only state used by logging and the JSON run summary below. None of these
# variables change install/update/skip decisions; they only enrich logging/reporting.
$summaryStamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$script:SummaryArtifactPath = Join-Path -Path $Folder -ChildPath ("LGAgentSummary_MSI_{0}.json" -f $summaryStamp)
$script:RunSummaryWritten = $false

$environmentInput         = $Environment
$resolvedEnvironmentValue = $null
$installedVersion         = $null
$installInfo              = $null
$msiVersion               = $null
$exitCode                 = $null
$msiExitCode              = $null
$logPath                  = $null
$decidedAction            = 'Pending'
$finalStatus              = $null
$deviceIdentity           = $null
$detectionSnapshot        = $null
$isElevated               = $null
$script:ScriptExitCode    = $null
$discoverySettingsDetected = $false
$discoveryIndicators      = New-Object System.Collections.Generic.List[string]
$summaryWarnings          = New-Object System.Collections.Generic.List[string]
# Phase 4 update-parameter-policy state (set during the version gate / policy section).
$agentAlreadyInstalled    = $false
$installedVersionUnknown  = $false
$installerVersionUnknown  = $false
$installParameterMode     = 'NotApplicable'
$withheldRegistrationParameters = @()
$useUpgradeSafe           = $false
$registrationParamsReasserted = $false
$updateParameterPolicyNotApplicableReason = $null
# Optional API-backed features. API tokens are required only when one of these is enabled;
# otherwise the base install path makes no Liongard API calls and needs no API tokens.
$apiFeatureEnabled        = ([bool]$EnableEnvironmentNameMatching) -or ([bool]$EnableEnvironmentDeviceValidation)
# Phase 6 advisory environment/device validation state (set after environment resolution).
$environmentValidation    = $null
$environmentValidationStatus = 'Skipped'
$environmentValidationStrictModeBlocked = $false
# Phase 7 PowerShell PATH integrity state (set by the Phase 7 block below and the post-install hook).
$powerShellPathDiagnostics           = $null
$powerShellPathStatus                = 'NotChecked'
$powerShellPathPostRepairStatus      = $null
$powerShellPathRepairAttempted       = $false
$powerShellPathRepairSucceeded       = $false
$powerShellPathEntriesAdded          = @()
$powerShellPathValueKindCorrected    = $false
$pathExtRepairApplied                = $false
$powerShellPathBackupFile            = $null
$pathExtBackupFile                   = $null
$powerShellPathServiceOverrideApplied = $false
$powerShellPathServicesRestarted     = 0
$powerShellPathRebootRecommended     = $false
$powerShellExecutionProbeResult      = $null
$powerShellPathCorrectedExpandedPath = $null
$powerShellPathServiceMitigationDone  = $false

# Phase 2: fail-fast elevation pre-check (SYSTEM counts as elevated; no self-elevation).
$isElevated = Get-IsElevated
if (-not $isElevated) {
    Write-Error ("[Preflight][ERROR] This script must run elevated as Administrator or SYSTEM. Detected non-elevated context for user '{0}\{1}'. Aborting." -f $env:USERDOMAIN, $env:USERNAME)
    $finalStatus = 'NotElevated'
    Exit-MsiRun -Code 10 -Reason 'NotElevated'
}

# Validate all required configuration values. Phase 2: catch the placeholder/missing-value
# throws so they map to the standardized config-validation exit code (11) instead of a raw
# unhandled-exception exit. The validation behavior itself is unchanged (still aborts).
try {
    Assert-ConfigurationValue -Name 'InstancePrefix'   -Value $InstancePrefix
    Assert-ConfigurationValue -Name 'AgentTokenKey'    -Value $AgentTokenKey
    Assert-ConfigurationValue -Name 'AgentTokenSecret' -Value $AgentTokenSecret
    if ($IncludeEnvironmentValue) {
        Assert-ConfigurationValue -Name 'Environment' -Value $Environment
    }

    # API tokens are OPTIONAL for the base install. They are required only when an optional
    # API-backed feature (environment name matching or environment/device validation) is enabled.
    if ($apiFeatureEnabled) {
        foreach ($apiToken in @(@('ApiTokenKey', $ApiTokenKey), @('ApiTokenSecret', $ApiTokenSecret))) {
            if ([string]::IsNullOrWhiteSpace($apiToken[1]) -or $apiToken[1] -like 'REPLACE_WITH_*') {
                throw ("Configuration value [{0}] is required because an optional API-backed feature is enabled (EnableEnvironmentNameMatching={1}, EnableEnvironmentDeviceValidation={2}). Provide valid API tokens, or set both features to `$false to install with only the agent install token." -f $apiToken[0], $EnableEnvironmentNameMatching, $EnableEnvironmentDeviceValidation)
            }
        }
    }
}
catch {
    Write-Error $_.Exception.Message
    $finalStatus = 'ConfigValidationFailed'
    Exit-MsiRun -Code 11 -Reason 'ConfigValidationFailed'
}

# Catch placeholder-style wildcard characters that Assert-ConfigurationValue does not cover.
if ($InstancePrefix -match '[?*\[\]]') {
    Write-Error "InstancePrefix '$InstancePrefix' contains a placeholder character. Provide a valid instance prefix (e.g. us1, eu2)."
    $finalStatus = 'ConfigValidationFailed'
    Exit-MsiRun -Code 11 -Reason 'InstancePrefixInvalid'
}

Write-ConfigurationSnapshot

# Read-only device identity + agent detection snapshot (Phase 1). Logged for visibility
# and the run summary only; no install/update/skip decision is changed by these values.
$isElevated        = Get-IsElevated
$deviceIdentity    = Get-LocalDeviceIdentity
$detectionSnapshot = Get-LiongardDetectionSnapshot

Write-Host "=== Local Device Identity (read-only) ==="
Write-Host ("Is Elevated / SYSTEM   : {0}" -f $isElevated)
Write-Host ("Execution Identity     : {0}\{1}" -f $env:USERDOMAIN, $env:USERNAME)
Write-Host ("MachineGuid            : {0}" -f $deviceIdentity.MachineGuid)
Write-Host ("Hardware UUID          : {0}" -f $deviceIdentity.HardwareUuid)
Write-Host ("NETBIOS Name           : {0}" -f $deviceIdentity.NetbiosName)
Write-Host ("Hostname               : {0}" -f $deviceIdentity.Hostname)
Write-Host ("FQDN                   : {0}" -f $deviceIdentity.Fqdn)
Write-Host ("MAC Addresses          : {0}" -f (@($deviceIdentity.MacAddresses) -join ', '))
Write-Host "========================================="

Write-Host "=== Agent Detection Snapshot (read-only) ==="
Write-Host ("Detection State            : {0}" -f $detectionSnapshot.State)
Write-Host ("Uninstall Registry Present : {0}" -f $detectionSnapshot.RegistryPresent)
Write-Host ("Service Present            : {0}" -f $detectionSnapshot.ServicePresent)
Write-Host ("Service Running            : {0}" -f $detectionSnapshot.ServiceRunning)
Write-Host ("Service Statuses           : {0}" -f (@($detectionSnapshot.Services | ForEach-Object { "$($_.Name)=$($_.Status)" }) -join ', '))
Write-Host ("Deployment Path            : MSI (standard agent path)")
Write-Host ("Discovery Dependencies     : none expected on the MSI path (no Npcap / VC++ / discovery)")
Write-Host "============================================"

# Phase 3: discovery-safety guard. The MSI path is the standard, non-scanning path; it never
# installs Npcap/VC++ or enables network discovery. Detect discovery/scanning settings that may
# have been copy-pasted in from the EXE script (variables now; the built MSI argument list is
# re-checked just before msiexec runs). This does NOT add any discovery functionality.
Write-Host "=== Discovery Safety (read-only) ==="
Write-Host "This MSI script is the STANDARD non-scanning agent path."
Write-Host "No discovery dependencies (Npcap / Visual C++ via the discovery package) will be installed."
Write-Host "Network discovery will NOT be enabled and network_discovery.yml will NOT be modified."
foreach ($discoveryVar in @('DiscoveryDeviceOptIn','WhenNotDesignated','EnableNetworkDiscovery','InstallNpcap','EffectiveEnableNetworkDiscovery','EffectiveInstallNpcap')) {
    if (Test-Path -Path ("Variable:\{0}" -f $discoveryVar)) {
        $discoveryIndicators.Add("variable:`$$discoveryVar") | Out-Null
    }
}
if ($discoveryIndicators.Count -gt 0) {
    $discoverySettingsDetected = $true
    Write-Warning ("Discovery/scanning settings detected in this standard MSI script: {0}. They are IGNORED here (the MSI path installs no discovery dependencies and never enables discovery). For network discovery/scanning, use the EXE script on the designated device." -f ($discoveryIndicators -join ', '))
    if ($BlockDiscoverySettings) {
        $finalStatus = 'DiscoverySettingsBlocked'
        Exit-MsiRun -Code 11 -Reason 'DiscoverySettingsDetected'
    }
}
else {
    Write-Host "No discovery/scanning settings detected."
}
Write-Host "===================================="

# ================================================================================================
# Phase 7 - PowerShell PATH integrity check / repair
#
# Runs BEFORE the download and install so the machine is healthy by the time the agent registers,
# and so an already-installed-but-broken agent is fixed even when the version gate later decides
# to skip the install entirely (the common case on Andrew's affected endpoints).
#
# Gate 1: $EnablePowerShellPathCheck  -> skip the whole phase.
# Gate 2: $RepairPowerShellPath       -> detect and report only; make no writes.
# ================================================================================================
if (-not $EnablePowerShellPathCheck) {
    $powerShellPathStatus = 'SkippedByConfig'
    Write-Host "=== PowerShell PATH Integrity (Phase 7) ==="
    Write-Host "[PSPath] Disabled by configuration (`$EnablePowerShellPathCheck = `$false). No detection or repair performed."
    Write-Host "==========================================="
}
else {
    $powerShellPathDiagnostics = Get-PowerShellPathDiagnostics -LengthWarningThreshold $MachinePathLengthWarningThreshold -RunExecutionProbe ([bool]$TestPowerShellExecution)
    $powerShellPathStatus           = $powerShellPathDiagnostics.Status
    $powerShellExecutionProbeResult = $powerShellPathDiagnostics.ExecutionProbe

    $pathRepairResult      = $null
    $serviceMitigationResult = $null

    if ($powerShellPathDiagnostics.Healthy) {
        Write-Host "[PSPath] powershell.exe resolves correctly from the machine PATH; no repair required."
    }
    elseif (-not $RepairPowerShellPath) {
        # Audit mode. Report the diagnosis in full and change nothing.
        Write-Warning "[PSPath] A PowerShell PATH problem was detected but auto-repair is disabled (`$RepairPowerShellPath = `$false). Reporting only; no changes made."
    }
    elseif (-not $powerShellPathDiagnostics.Repairable) {
        # powershell.exe is not on disk. Editing PATH cannot help; say so plainly instead of
        # writing a change that will not fix anything.
        Write-Warning "[PSPath] The failure is NOT repairable by a PATH edit on this device. See findings above."
    }
    else {
        $powerShellPathRepairAttempted = $true
        $pathRepairResult = Invoke-PowerShellPathRepair -Diagnostics $powerShellPathDiagnostics `
                                                        -TargetFolder $Folder `
                                                        -RepairPath $true `
                                                        -RepairPathExtValue ([bool]$RepairPathExt) `
                                                        -NormalizeEntries ([bool]$NormalizeMachinePathEntries) `
                                                        -LengthWarningThreshold $MachinePathLengthWarningThreshold

        $powerShellPathEntriesAdded       = @($pathRepairResult.EntriesAdded)
        $powerShellPathValueKindCorrected = [bool]$pathRepairResult.ValueKindCorrected
        $pathExtRepairApplied             = [bool]$pathRepairResult.PathExtChanged
        $powerShellPathBackupFile         = $pathRepairResult.PathBackupFile
        $pathExtBackupFile                = $pathRepairResult.PathExtBackupFile

        foreach ($e in @($pathRepairResult.Errors)) { $summaryWarnings.Add("[PSPath] $e") | Out-Null }

        if ($pathRepairResult.PathChanged -or $pathRepairResult.PathExtChanged) {
            # Update THIS process so msiexec and every other child launched below inherits the
            # corrected values immediately, without waiting for the broadcast or a reboot.
            $refreshedPath = Get-MachineEnvironmentValueInfo -Name 'Path'
            if ($refreshedPath.Exists -and -not [string]::IsNullOrWhiteSpace($refreshedPath.ExpandedValue)) {
                $powerShellPathCorrectedExpandedPath = [string]$refreshedPath.ExpandedValue
                $env:Path = $powerShellPathCorrectedExpandedPath
            }
            $refreshedPathExt = Get-MachineEnvironmentValueInfo -Name 'PATHEXT'
            if ($refreshedPathExt.Exists -and -not [string]::IsNullOrWhiteSpace($refreshedPathExt.ExpandedValue)) {
                $env:PATHEXT = [string]$refreshedPathExt.ExpandedValue
            }

            if ($BroadcastEnvironmentChange) { [void](Send-EnvironmentChangeBroadcast) }

            # Re-run detection to confirm the repair actually took.
            $postRepair = Get-PowerShellPathDiagnostics -LengthWarningThreshold $MachinePathLengthWarningThreshold -RunExecutionProbe $false
            $powerShellPathPostRepairStatus = $postRepair.Status
            $powerShellPathRepairSucceeded  = [bool]$postRepair.Healthy

            if ($powerShellPathRepairSucceeded) {
                Write-Host ("[PSPath] Repair verified: powershell.exe now resolves from the machine PATH at [{0}]." -f $postRepair.ResolvedFromMachinePath)
            }
            else {
                Write-Warning ("[PSPath] Repair was written but verification still reports status '{0}'. Findings: {1}" -f $postRepair.Status, (@($postRepair.Findings) -join ', '))
            }

            # Deliver the corrected PATH to the agent service without requiring a reboot. Only
            # meaningful if the agent is already installed; the post-install hook repeats this for
            # a fresh install once the service exists.
            if ($powerShellPathCorrectedExpandedPath) {
                $serviceMitigationResult = Invoke-LiongardServicePathMitigation -ExpandedPath $powerShellPathCorrectedExpandedPath `
                                                                                -ApplyOverride ([bool]$ApplyServiceEnvironmentOverride) `
                                                                                -RestartService ([bool]$RestartAgentServiceAfterPathRepair)
                if ($serviceMitigationResult.ServicesFound -gt 0) {
                    $powerShellPathServiceMitigationDone = $true
                    $powerShellPathServiceOverrideApplied = ($serviceMitigationResult.OverridesApplied -gt 0)
                    $powerShellPathServicesRestarted      = $serviceMitigationResult.ServicesRestarted
                    $powerShellPathRebootRecommended      = [bool]$serviceMitigationResult.RebootStillNeeded
                    foreach ($e in @($serviceMitigationResult.Errors)) { $summaryWarnings.Add("[PSPath] $e") | Out-Null }
                }
                else {
                    Write-Host "[PSPath] No Liongard service present yet; the service environment override will be applied after the install completes."
                }
            }
        }
        else {
            Write-Warning "[PSPath] Repair produced no change. Either the required entries were already present under a different form, or the registry write failed (see errors above)."
        }
    }

    Write-PowerShellPathReport -Diagnostics $powerShellPathDiagnostics -Repair $pathRepairResult -ServiceMitigation $serviceMitigationResult

    # Optional hard stop. Default is advisory: warn and continue, so a PATH problem never blocks an
    # install that would otherwise succeed. Only fires when PowerShell is genuinely unresolvable
    # AND the repair did not fix it.
    $stillBroken = (-not $powerShellPathDiagnostics.Healthy) -and (-not $powerShellPathRepairSucceeded)
    if ($stillBroken) {
        if ($FailOnPowerShellPathUnrepairable) {
            Write-Error ("[PSPath][ERROR] PowerShell cannot be resolved from PATH and the condition was not repaired (status '{0}'). FailOnPowerShellPathUnrepairable is true, so the run is aborting." -f $powerShellPathStatus)
            $finalStatus = 'PowerShellPathUnrepairable'
            Exit-MsiRun -Code 44 -Reason 'PowerShellPathUnrepairable'
        }
        else {
            Write-Warning ("[PSPath][WARN] PowerShell PATH problem persists (status '{0}'). Continuing because FailOnPowerShellPathUnrepairable is false. The agent may install successfully but fail to run inspections with: exec: `"powershell`": executable file not found in %PATH%" -f $powerShellPathStatus)
            $summaryWarnings.Add(("[PSPath] Unresolved PowerShell PATH condition: {0}" -f $powerShellPathStatus)) | Out-Null
        }
    }
}

$instancePrefix = Resolve-InstancePrefix -Value $InstancePrefix
$liongardHost   = "$instancePrefix.app.liongard.com"
Write-Host "Liongard instance host: $liongardHost"

$localHostname = $env:COMPUTERNAME
Write-Host "Local hostname: $localHostname"

# Build API auth headers only when an optional API-backed feature is enabled; the base install
# path makes no Liongard API calls and needs no API tokens.
$headers = if ($apiFeatureEnabled) { Get-LiongardAuthHeader -ApiTokenKey $ApiTokenKey -ApiTokenSecret $ApiTokenSecret } else { $null }

# Resolve the environment name against the Liongard API to catch casing or punctuation
# differences before they are baked into the agent record. Optional API-backed feature: runs only
# when $EnableEnvironmentNameMatching = $true; otherwise the supplied value passes through unchanged.
if (-not $EnableEnvironmentNameMatching) {
    $script:EnvironmentResolutionReason = 'MatchingDisabledByConfig'
    Write-Host "API-backed environment name matching is disabled by configuration; the supplied environment value is passed through unchanged (no environment lookup API call)."
}
elseif ($IncludeEnvironmentValue -and -not [string]::IsNullOrWhiteSpace($Environment)) {
    $script:EnvironmentResolutionReason = $null
    $resolvedEnvironment = Resolve-LiongardEnvironmentName -InputName $Environment -InstancePrefix $instancePrefix -Headers $headers

    if ($resolvedEnvironment -and -not [string]::Equals($resolvedEnvironment, $Environment, [System.StringComparison]::Ordinal)) {
        Write-Host ("Matched provided environment to Liongard: '{0}' -> '{1}' (Reason: {2})" -f $Environment, $resolvedEnvironment, $script:EnvironmentResolutionReason)
        $Environment = $resolvedEnvironment
    }
    elseif ($resolvedEnvironment) {
        Write-Host ("Environment confirmed in Liongard: '{0}' (Reason: {1})" -f $Environment, $script:EnvironmentResolutionReason)
    }
    else {
        $normalizedEnv = Normalize-EnvironmentName -Value $Environment
        $reasonLabel   = if ($script:EnvironmentResolutionReason) { $script:EnvironmentResolutionReason } else { 'Unknown' }

        if ($reasonLabel -eq 'NoEnvironmentsReturned') {
            Write-Warning ("Environment lookup API returned no environments for host '{0}'. Continuing with the supplied LIONGARDENVIRONMENT value '{1}' without API confirmation." -f $liongardHost, $Environment)
        }
        else {
            Write-Error ("Environment '{0}' (normalized '{1}') could not be resolved in Liongard. Reason: {2}. Aborting installation because LIONGARDENVIRONMENT is required." -f $Environment, $normalizedEnv, $reasonLabel)
            $resolvedEnvironmentValue = $Environment
            $finalStatus = 'EnvironmentResolutionFailed'
            Exit-MsiRun -Code 11 -Reason 'EnvironmentUnresolved'
        }
    }
}

# Capture the (possibly API-corrected) environment value for read-only reporting.
$resolvedEnvironmentValue = $Environment

# ================================
# Phase 6 - Environment / Device Validation Advisory (read-only, best-effort)
# Optional API-backed feature. Runs only when $EnableEnvironmentDeviceValidation = $true. Advisory
# by default; only a HIGH-confidence different-environment match aborts, and only when
# $FailOnEnvironmentMismatch = $true. Strict blocking is possible ONLY when this feature is enabled.
# Never re-registers or modifies any record.
# ================================
if ($EnableEnvironmentDeviceValidation) {
    $environmentValidation = Invoke-EnvironmentDeviceValidation -InstancePrefix $instancePrefix -Headers $headers -DeviceIdentity $deviceIdentity -ExpectedEnvironment $resolvedEnvironmentValue -HighConfidenceThreshold $EnvironmentValidationHighConfidenceThreshold
}
else {
    $environmentValidation = [pscustomobject]@{
        Status                 = 'SkippedByConfig'
        ApiAvailable           = $false
        ConfidenceScore        = 0
        ConfidenceLevel        = 'None'
        MatchedAgentId         = $null
        MatchedAgentName       = $null
        MatchedEnvironment     = $null
        ExpectedEnvironment    = $resolvedEnvironmentValue
        MatchSignals           = @()
        Mismatch               = $false
        HighConfidenceMismatch = $false
        Warnings               = @()
    }
}
$environmentValidationStatus = $environmentValidation.Status

Write-Host "=== Environment / Device Validation Advisory ==="
Write-Host ("EnableEnvironmentDeviceValidation : {0}" -f $EnableEnvironmentDeviceValidation)
if (-not $EnableEnvironmentDeviceValidation) {
    Write-Host "API-backed environment/device validation is disabled by configuration; the advisory validation was skipped (no agent validation API call)."
}
Write-Host ("Status                 : {0}" -f $environmentValidation.Status)
Write-Host ("API available          : {0}" -f $environmentValidation.ApiAvailable)
Write-Host ("Expected environment   : {0}" -f $environmentValidation.ExpectedEnvironment)
Write-Host ("Matched agent          : {0}" -f $(if ($environmentValidation.MatchedAgentId) { "$($environmentValidation.MatchedAgentId) ($($environmentValidation.MatchedAgentName))" } else { 'none' }))
Write-Host ("Matched environment    : {0}" -f $(if ($environmentValidation.MatchedEnvironment) { $environmentValidation.MatchedEnvironment } else { 'unknown' }))
Write-Host ("Confidence score/level : {0} / {1}" -f $environmentValidation.ConfidenceScore, $environmentValidation.ConfidenceLevel)
Write-Host ("Match signals          : {0}" -f $(if (@($environmentValidation.MatchSignals).Count -gt 0) { @($environmentValidation.MatchSignals) -join ', ' } else { 'None' }))
Write-Host ("Mismatch detected      : {0}" -f $environmentValidation.Mismatch)
Write-Host ("Strict mode            : {0}" -f $FailOnEnvironmentMismatch)
foreach ($vw in @($environmentValidation.Warnings)) { Write-Warning ([string]$vw) }

if ($environmentValidation.Mismatch) {
    if ($FailOnEnvironmentMismatch -and $environmentValidation.HighConfidenceMismatch) {
        $environmentValidationStrictModeBlocked = $true
        Write-Host ("Strict mode blocked run: {0}" -f $true)
        Write-Error "[EnvironmentValidation][ERROR] High-confidence environment mismatch detected. FailOnEnvironmentMismatch is true, so install/update will not proceed."
        $finalStatus = 'EnvironmentMismatchBlocked'
        Exit-MsiRun -Code 11 -Reason 'EnvironmentMismatchBlocked'
    }
    else {
        Write-Host ("Strict mode blocked run: {0}" -f $false)
        Write-Warning "[EnvironmentValidation][WARN] This device appears to already exist in Liongard under a different environment. Continuing because FailOnEnvironmentMismatch is false (or the match is not high-confidence)."
    }
}
else {
    Write-Host ("Strict mode blocked run: {0}" -f $false)
}
Write-Host "================================================"

# Prepare the download directory.
Write-Host "Checking if folder [$Folder] exists..."
if (-not (Test-Path -Path $Folder)) {
    Write-Host "Creating directory at [$Folder]..."
    New-Item -Path $Folder -ItemType Directory -Force | Out-Null
}

if (-not (Test-Path -Path $Folder)) {
    Write-Error "Failed to create directory [$Folder]. Check permissions and rerun the script."
    $finalStatus = 'FolderCreationFailed'
    Exit-MsiRun -Code 20 -Reason 'FolderUnavailable'
}

$installerPath = Join-Path -Path $Folder -ChildPath 'LiongardAgent-lts.msi'
if (-not (Get-LiongardInstaller -Uri $InstallerUrl -DestinationPath $installerPath)) {
    Write-Error "Failed to download installer from [$InstallerUrl] after multiple attempts. Aborting."
    $finalStatus = 'DownloadFailed'
    Exit-MsiRun -Code 20 -Reason 'InstallerDownloadFailed'
}

# Version gate: compare the downloaded MSI against any currently installed agent.
# Proceed only when no agent is present, or the MSI is strictly newer.
# Installed-agent version + presence come from the ProductCode-agnostic detection helper -- the
# legacy single-product-code DisplayVersion read is no longer the sole source. See
# Get-LiongardAgentInstallInfo.
$installInfo = Get-LiongardAgentInstallInfo
$installedVersion = $installInfo.Version
$agentAlreadyInstalled = ([bool]$installInfo.Installed -or ($detectionSnapshot -and $detectionSnapshot.State -ne 'NotDetected') -or [bool]$installedVersion)
$msiVersion = $null
if ($agentAlreadyInstalled) {
    $msiVersion = Get-MsiProductVersion -Path $installerPath
}
$installerVersionUnknown = ($agentAlreadyInstalled -and -not $msiVersion)
$installedVersionUnknown = ($agentAlreadyInstalled -and -not $installedVersion)
foreach ($w in @($installInfo.Warnings)) { $summaryWarnings.Add([string]$w) | Out-Null; Write-Warning ([string]$w) }
Write-Host "=== Installed Agent Detection ==="
Write-Host ("Installed Agent Detected   : {0}" -f $installInfo.Installed)
Write-Host ("Detection Method           : {0}" -f $installInfo.DetectionMethod)
Write-Host ("Installed Version          : {0}" -f $(if ($installedVersion) { $installedVersion.ToString() } else { '<unknown / none>' }))
Write-Host ("Installed Version Source   : {0}" -f $installInfo.VersionSource)
Write-Host ("Installed Product Code     : {0}" -f $(if ($installInfo.ProductCode) { $installInfo.ProductCode } else { '<n/a>' }))
Write-Host ("Installed Uninstall Key    : {0}" -f $(if ($installInfo.UninstallKeyPath) { $installInfo.UninstallKeyPath } else { '<n/a>' }))
Write-Host "================================="

if ($installedVersion -and $msiVersion -and $msiVersion -le $installedVersion) {
    Write-Host ("Liongard Agent {0} is already installed and the downloaded MSI ({1}) is not a newer version. Skipping installation." -f $installedVersion, $msiVersion)
    $decidedAction = 'SkipUpToDate'
    $finalStatus = 'SkippedUpToDate'
    $updateParameterPolicyNotApplicableReason = 'AlreadyCurrentSkip'
    Exit-MsiRun -Code 0 -Reason 'AlreadyCurrent'
}
elseif ($agentAlreadyInstalled -and $installerVersionUnknown) {
    # Phase 4: installer (MSI) version unreadable AND an agent is already present. Skip to
    # avoid a blind reinstall/update over an existing (possibly newer) agent.
    Write-Warning "Unable to read ProductVersion from the downloaded MSI and an agent is already installed; skipping the install/update to avoid overwriting an existing agent."
    $decidedAction = 'SkipInstallerVersionUnknown'
    $finalStatus = 'SkippedUpToDate'
    $updateParameterPolicyNotApplicableReason = 'InstallerVersionUnknownSkip'
    Exit-MsiRun -Code 0 -Reason 'InstallerVersionUnknownSkip'
}
elseif ($installedVersion) {
    Write-Host ("Newer version detected. Proceeding with an in-place update: {0} -> {1}." -f $installedVersion, $msiVersion)
}
elseif ($agentAlreadyInstalled) {
    Write-Host "Agent detected but its installed version could not be determined; proceeding with an in-place update (upgrade-safe properties)."
}

# Read-only label of the action the existing logic will take (no decision changed here).
$decidedAction = if ($agentAlreadyInstalled) { 'Upgrade' } else { 'Install' }
Write-Host ("Pre-action decision (existing logic): {0}" -f $decidedAction)

Write-Host "Installing the Liongard Agent..."

$logPath = Join-Path -Path $Folder -ChildPath 'AgentInstall.log'
if (Test-Path -LiteralPath $logPath) {
    Write-Host "Removing existing installer log [$logPath] to capture fresh results..."
    Remove-Item -LiteralPath $logPath -Force -ErrorAction SilentlyContinue
}

# ================================
# Phase 4 - Update Parameter Policy
# Fresh install -> full properties. In-place update -> upgrade-safe properties by default
# (registration/config withheld), unless $ReassertInstallParametersOnUpdate re-asserts them.
# ================================
if ($agentAlreadyInstalled) {
    if ($ReassertInstallParametersOnUpdate) {
        $installParameterMode = 'FullPropertiesReassertedOnUpdate'
    }
    else {
        $installParameterMode = 'UpgradeSafeProperties'
    }
}
else {
    $installParameterMode = 'FullInstallProperties'
}
$useUpgradeSafe = ($installParameterMode -eq 'UpgradeSafeProperties')
$registrationParamsReasserted = ($installParameterMode -eq 'FullPropertiesReassertedOnUpdate')
$withheldRegistrationParameters = if ($useUpgradeSafe) {
    @('LIONGARDURL','LIONGARDACCESSKEY','LIONGARDACCESSSECRET','LIONGARDAGENTNAME','LIONGARDENVIRONMENT','LIONGARDDESCRIPTION')
}
else { @() }

Write-Host "=== Update Parameter Policy ==="
Write-Host ("ReassertInstallParametersOnUpdate : {0}" -f $ReassertInstallParametersOnUpdate)
Write-Host ("Decision                          : {0}" -f $installParameterMode)
Write-Host ("Service Health (read-only)        : {0}" -f $(if ($detectionSnapshot) { $detectionSnapshot.State } else { '<unknown>' }))
Write-Host ("Withheld registration properties  : {0}" -f $(if ($withheldRegistrationParameters.Count -gt 0) { $withheldRegistrationParameters -join ', ' } else { '<none>' }))
if ($registrationParamsReasserted) {
    Write-Warning "[UpdatePolicy][WARN] Registration/configuration parameters are being reasserted during update. This may overwrite existing local Liongard Agent configuration."
}
Write-Host "==============================="

$msiArguments = @("/i", "`"$installerPath`"")

if (-not $useUpgradeSafe) {
    # Registration/configuration properties: passed only on a fresh install (or when re-asserted).
    $msiArguments += @(
        "LIONGARDURL=$liongardHost",
        "LIONGARDACCESSKEY=$AgentTokenKey",
        "LIONGARDACCESSSECRET=$AgentTokenSecret",
        "LIONGARDAGENTNAME=`"$localHostname`""
    )

    if ($IncludeEnvironmentValue -and -not [string]::IsNullOrWhiteSpace($Environment)) {
        $msiArguments += "LIONGARDENVIRONMENT=`"$Environment`""
    }

    if (-not [string]::IsNullOrWhiteSpace($AgentDescription)) {
        $msiArguments += "LIONGARDDESCRIPTION=`"$AgentDescription`""
    }
}

$msiArguments += @("/qn", "/norestart", "/L*V", "`"$logPath`"")

# Phase 3: safety net — the MSI argument list is built from a fixed, discovery-free template.
# Re-scan it before launching msiexec in case a discovery property was hand-edited in. The MSI
# path must never pass enhanced-network-discovery / Npcap properties.
$discoveryArgMatches = @($msiArguments | Where-Object { $_ -match '(?i)(InstallEnhancedNetworkDiscovery|InstallNpcap|EnableNetworkDiscovery|network_discovery)' })
if ($discoveryArgMatches.Count -gt 0) {
    $discoverySettingsDetected = $true
    foreach ($m in $discoveryArgMatches) { $discoveryIndicators.Add("argument:$m") | Out-Null }
    Write-Warning ("Discovery/scanning properties found in the MSI argument list: {0}. The MSI path must not install discovery dependencies." -f ($discoveryArgMatches -join ', '))
    if ($BlockDiscoverySettings) {
        $finalStatus = 'DiscoverySettingsBlocked'
        Exit-MsiRun -Code 11 -Reason 'DiscoverySettingsDetected'
    }
}

$process  = Start-Process -FilePath "msiexec.exe" -ArgumentList $msiArguments -Wait -PassThru
$exitCode = if ($process) { $process.ExitCode } else { $LASTEXITCODE }
Write-Host "Installation command completed. Evaluating results..."

$summary = Read-MsiLogSummary -Path $logPath -MaxWaitSeconds 60
if ($summary.Found) {
    $resultText = Get-MsiResultText -Code $summary.Code
    if ($summary.InvalidMsg) {
        Write-Host ("MSI status: {0} ({1})`nReason: {2}" -f $summary.Code, $resultText, $summary.InvalidMsg)
    }
    else {
        Write-Host ("MSI status: {0} ({1})`nLog line: {2}" -f $summary.Code, $resultText, $summary.Line)
    }
}
else {
    if (Test-Path -LiteralPath $logPath) {
        Write-Host "MSI log available at [$logPath], but no summary pattern was found."
    }
    else {
        Write-Warning "MSI log file [$logPath] was not found."
    }
}

$msiExitCode = if ($summary.Found) { $summary.Code } else { $exitCode }

Start-Sleep -Seconds 2
$agentDetected = $false
for ($attempt = 0; $attempt -lt 3; $attempt++) {
    if (Test-LiongardAgentInstalled) {
        $agentDetected = $true
        break
    }
    Start-Sleep -Seconds 2
}

if (-not $summary.Found -and $agentDetected -and $exitCode -eq 0) {
    $msiExitCode = 0
}

if (($msiExitCode -eq 0 -or $msiExitCode -eq 3010) -and $agentDetected) {
    Write-Host "Liongard Agent installation verified successfully (process=$exitCode, msi=$msiExitCode)."
    $finalStatus = if ($msiExitCode -eq 3010) { 'SuccessReboot' } else { 'Success' }

    # ------------------------------------------------------------------------------------------
    # Phase 7 post-install hook. On a FRESH install the agent service did not exist when the PATH
    # repair ran, so the per-service Environment override could not be written then. Apply it now
    # and restart the service, so the newly registered agent starts with a correct PATH instead of
    # inheriting the stale boot-time SCM environment block.
    # ------------------------------------------------------------------------------------------
    if ($EnablePowerShellPathCheck -and $powerShellPathRepairAttempted -and -not $powerShellPathServiceMitigationDone) {
        if ($powerShellPathCorrectedExpandedPath) {
            Write-Host "[PSPath] Applying the corrected PATH to the newly installed agent service..."
            $postInstallMitigation = Invoke-LiongardServicePathMitigation -ExpandedPath $powerShellPathCorrectedExpandedPath `
                                                                          -ApplyOverride ([bool]$ApplyServiceEnvironmentOverride) `
                                                                          -RestartService ([bool]$RestartAgentServiceAfterPathRepair)
            if ($postInstallMitigation.ServicesFound -gt 0) {
                $powerShellPathServiceMitigationDone  = $true
                $powerShellPathServiceOverrideApplied = ($postInstallMitigation.OverridesApplied -gt 0)
                $powerShellPathServicesRestarted      = $postInstallMitigation.ServicesRestarted
                $powerShellPathRebootRecommended      = [bool]$postInstallMitigation.RebootStillNeeded
                foreach ($e in @($postInstallMitigation.Errors)) { $summaryWarnings.Add("[PSPath] $e") | Out-Null }
            }
            else {
                Write-Warning "[PSPath] No Liongard service was found after a reportedly successful install; the service environment override could not be applied."
                $powerShellPathRebootRecommended = $true
            }
            Write-PowerShellPathReport -Diagnostics $powerShellPathDiagnostics -Repair $null -ServiceMitigation $postInstallMitigation
        }
        else {
            Write-Warning "[PSPath] A repair was attempted but no corrected PATH value was captured; skipping the service environment override."
        }
    }

    Start-Sleep -Seconds 3
    Write-Host "Exiting script..."
    $successCode = if ($msiExitCode -eq 3010) { 2 } else { 0 }
    Exit-MsiRun -Code $successCode -Reason 'InstallVerified'
}

Write-Warning "Liongard Agent installation failed or agent not detected. Exit code: $exitCode | MSI status: $msiExitCode"
if ($summary.InvalidMsg) {
    Write-Warning "MSI reported: $($summary.InvalidMsg)"
}
if (-not $agentDetected) {
    Write-Warning "Test-LiongardAgentInstalled returned false after the install attempt."
}
Start-Sleep -Seconds 5

# Phase 2: classify the failure for a standardized exit code. The raw MSI code is preserved
# in the warning above and in the JSON summary. Behavior of the install itself is unchanged.
#   - Installer reported success (0/3010) but agent not detected -> partial validation (43).
#   - Installer returned an error -> update failure (41) if an agent was already installed
#     (the existing upgrade branch), otherwise fresh-install failure (40).
if ($msiExitCode -eq 0 -or $msiExitCode -eq 3010) {
    $finalStatus = 'PartialValidation'
    $failCode = 43
}
elseif ($agentAlreadyInstalled) {
    $finalStatus = 'Failed'
    $failCode = 41
}
else {
    $finalStatus = 'Failed'
    $failCode = 40
}
Exit-MsiRun -Code $failCode -Reason 'InstallFailedOrNotDetected'
