# Stable codes for Intune/RMM. Separate from raw MSI codes (see Get-MsiResultText).
# ================================
function Get-ScriptExitCodeMeaning {
    param([int]$Code)
    switch ($Code) {
        0  { 'Success' }
        2  { 'Success, reboot required' }
        10 { 'Not running as admin' }
        11 { 'Configuration validation failure' }
        20 { 'Download failure' }
        21 { 'Installer missing or unreadable' }
        40 { 'Install failure' }
        41 { 'Update failure' }
        42 { 'Dependency failure' }
        43 { 'Partial validation failure' }
        44 { 'PowerShell PATH unresolvable and unrepairable' }
        50 { 'Uninstall failure' }
        51 { 'Remote platform deletion skipped due to low confidence' }
        1  { 'Unexpected exception' }
        default { 'Unknown' }
    }
}

# ================================================================================================
# Phase 7 - PowerShell PATH integrity: detection and repair
#
# Target failure (emitted by the Go agent, roaragent.exe):
#     exec: "powershell": executable file not found in %PATH%
#
# Go's exec.LookPath is called with the BARE name "powershell". It therefore needs BOTH:
#   (a) a Path entry containing powershell.exe, AND
#   (b) a PATHEXT that includes .EXE so the bare name can be extended.
# Either one being broken produces the identical error message, which is why single-cause fixes
# so often appear not to work.
#
# All functions below read first and write only what is missing. Nothing is removed or reordered.
# ================================================================================================

$script:SessionManagerEnvKey = 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment'
$script:DefaultPathExt = '.COM;.EXE;.BAT;.CMD;.VBS;.VBE;.JS;.JSE;.WSF;.WSH;.MSC'

function Get-MachineEnvironmentValueInfo {
    # Reads a machine-scope environment variable straight from the Session Manager hive, UNEXPANDED.
    #
    # Why not [Environment]::GetEnvironmentVariable(...,'Machine'): it expands tokens and hides the
    # registry value KIND, and the kind is one of the three root causes. A Path stored as REG_SZ
    # instead of REG_EXPAND_SZ leaves every %SystemRoot% token literal, so consumers -- including
    # the SCM environment block handed to the agent service -- see an unusable directory string.
    param([Parameter(Mandatory)][string]$Name)

    $result = [pscustomobject]@{
        Name            = $Name
        Exists          = $false
        RawValue        = $null
        ExpandedValue   = $null
        ValueKind       = $null
        IsExpandable    = $false
        ContainsTokens  = $false
        TokenUnexpanded = $false
        RawLength       = 0
        ExpandedLength  = 0
        ReadError       = $null
    }

    $key = $null
    try {
        $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($script:SessionManagerEnvKey, $false)
        if ($null -eq $key) {
            $result.ReadError = 'Session Manager Environment key could not be opened.'
            return $result
        }

        $raw = $key.GetValue($Name, $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
        if ($null -eq $raw) { return $result }

        $result.Exists    = $true
        $result.RawValue  = [string]$raw
        $result.RawLength = $result.RawValue.Length

        try { $result.ValueKind = [string]$key.GetValueKind($Name) } catch { }
        $result.IsExpandable   = ($result.ValueKind -eq 'ExpandString')
        $result.ContainsTokens = ($result.RawValue -match '%[^%]+%')

        try { $result.ExpandedValue = [System.Environment]::ExpandEnvironmentVariables($result.RawValue) }
        catch { $result.ExpandedValue = $result.RawValue }
        $result.ExpandedLength = ([string]$result.ExpandedValue).Length

        # The damaging combination: tokens present but the value is not an expandable type.
        $result.TokenUnexpanded = ($result.ContainsTokens -and -not $result.IsExpandable)
    }
    catch {
        $result.ReadError = $_.Exception.Message
    }
    finally {
        if ($key) { try { $key.Close() } catch { } }
    }

    return $result
}

function Split-EnvironmentPathEntries {
    # Splits a Path string the way a consumer would, retaining the original text of each entry so a
    # repair can be purely additive. Also flags empty entries and quoted entries, both of which are
    # common in hand-edited Paths.
    param([string]$Value)

    $entries = New-Object System.Collections.Generic.List[object]
    if ([string]::IsNullOrWhiteSpace($Value)) { return (ConvertTo-SafeArray $entries) }

    $ordinal = 0
    foreach ($part in ($Value -split ';')) {
        $ordinal++
        $trimmed  = $part.Trim()
        $unquoted = $trimmed.Trim('"')
        $isEmpty  = [string]::IsNullOrWhiteSpace($unquoted)

        $expanded = $null
        if (-not $isEmpty) {
            try { $expanded = [System.Environment]::ExpandEnvironmentVariables($unquoted) } catch { $expanded = $unquoted }
        }

        $entries.Add([pscustomobject]@{
            Ordinal        = $ordinal
            Raw            = $part
            Trimmed        = $trimmed
            Unquoted       = $unquoted
            Expanded       = $expanded
            IsEmpty        = $isEmpty
            WasQuoted      = ($trimmed -ne $unquoted)
            StillTokenized = ($null -ne $expanded -and $expanded -match '%[^%]+%')
        }) | Out-Null
    }

    return (ConvertTo-SafeArray $entries)
}

function ConvertTo-ComparablePath {
    # Canonical form for comparing two directory strings: expanded, unquoted, no trailing
    # separator, case-insensitive. Used so a repair never appends a directory that is already
    # present under a different spelling (e.g. trailing backslash, or literal vs tokenized).
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) { return $null }
    $work = $Value.Trim().Trim('"')
    try { $work = [System.Environment]::ExpandEnvironmentVariables($work) } catch { }
    $work = $work.TrimEnd('\', '/')
    if ([string]::IsNullOrWhiteSpace($work)) { return $null }
    return $work.ToUpperInvariant()
}

function Backup-MachineEnvironmentValue {
    # Writes the pre-change raw value to $Folder before any registry write, so Support can restore
    # the exact original string. Returns the backup file path, or $null if it could not be written.
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter()][string]$RawValue,
        [Parameter(Mandatory)][string]$TargetFolder
    )

    try {
        if (-not (Test-Path -LiteralPath $TargetFolder)) {
            New-Item -Path $TargetFolder -ItemType Directory -Force | Out-Null
        }

        $stamp      = Get-Date -Format 'yyyyMMdd_HHmmss'
        $backupPath = Join-Path -Path $TargetFolder -ChildPath ("EnvBackup_{0}_{1}.txt" -f $Name, $stamp)

        $lines = New-Object System.Collections.Generic.List[string]
        $lines.Add(("# Machine environment backup taken by LGAgentScript_MSI Phase 7")) | Out-Null
        $lines.Add(("# Timestamp   : {0}" -f (Get-Date).ToString('o'))) | Out-Null
        $lines.Add(("# Computer    : {0}" -f $env:COMPUTERNAME)) | Out-Null
        $lines.Add(("# Registry key: HKLM\{0}" -f $script:SessionManagerEnvKey)) | Out-Null
        $lines.Add(("# Value name  : {0}" -f $Name)) | Out-Null
        $lines.Add('# Raw (unexpanded) value follows on the final line.') | Out-Null
        $lines.Add('') | Out-Null
        $lines.Add([string]$RawValue) | Out-Null

        Set-Content -LiteralPath $backupPath -Value $lines -Encoding UTF8 -ErrorAction Stop
        return $backupPath
    }
    catch {
        Write-Warning "[PSPath] Unable to write environment backup for [$Name]: $($_.Exception.Message)"
        return $null
    }
}

function Set-MachineEnvironmentValue {
    # Writes a machine-scope environment value with an EXPLICIT registry value kind.
    #
    # Deliberately does NOT use [Environment]::SetEnvironmentVariable(...,'Machine'): that API can
    # write the value back as REG_SZ, which is one of the root causes this phase exists to repair.
    # Writing REG_EXPAND_SZ explicitly keeps %SystemRoot% tokens working for every consumer.
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][AllowEmptyString()][string]$Value,
        [Parameter()][ValidateSet('ExpandString', 'String')][string]$ValueKind = 'ExpandString'
    )

    $key = $null
    try {
        $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($script:SessionManagerEnvKey, $true)
        if ($null -eq $key) {
            return [pscustomobject]@{ Success = $false; Error = 'Session Manager Environment key could not be opened for write.' }
        }

        $kind = if ($ValueKind -eq 'String') { [Microsoft.Win32.RegistryValueKind]::String } else { [Microsoft.Win32.RegistryValueKind]::ExpandString }
        $key.SetValue($Name, $Value, $kind)
        return [pscustomobject]@{ Success = $true; Error = $null }
    }
    catch {
        return [pscustomobject]@{ Success = $false; Error = $_.Exception.Message }
    }
    finally {
        if ($key) { try { $key.Close() } catch { } }
    }
}

function Send-EnvironmentChangeBroadcast {
    # Broadcasts WM_SETTINGCHANGE("Environment") so Explorer and newly launched processes pick up
    # the change without a logoff. Does NOT reach running services -- that is handled separately by
    # the per-service Environment override. Entirely best-effort; never throws.
    try {
        if (-not ('LiongardNative.EnvBroadcast' -as [type])) {
            Add-Type -Namespace 'LiongardNative' -Name 'EnvBroadcast' -ErrorAction Stop -MemberDefinition @'
[System.Runtime.InteropServices.DllImport("user32.dll", SetLastError = true, CharSet = System.Runtime.InteropServices.CharSet.Auto)]
public static extern System.IntPtr SendMessageTimeout(
    System.IntPtr hWnd, uint Msg, System.UIntPtr wParam, string lParam,
    uint fuFlags, uint uTimeout, out System.UIntPtr lpdwResult);
'@
        }

        $HWND_BROADCAST   = [System.IntPtr]0xffff
        $WM_SETTINGCHANGE = 0x1A
        $SMTO_ABORTIFHUNG = 0x0002
        $out = [System.UIntPtr]::Zero

        [void][LiongardNative.EnvBroadcast]::SendMessageTimeout(
            $HWND_BROADCAST, $WM_SETTINGCHANGE, [System.UIntPtr]::Zero, 'Environment',
            $SMTO_ABORTIFHUNG, 5000, [ref]$out)

        return $true
    }
    catch {
        Write-Warning "[PSPath] WM_SETTINGCHANGE broadcast unavailable on this host (non-fatal): $($_.Exception.Message)"
        return $false
    }
}

function Resolve-ExecutableFromPathEntries {
    # Mimics Go's exec.LookPath: walk Path entries in order, and for a bare name try each PATHEXT
    # extension in turn. Directories whose tokens never expanded are skipped, because that is
    # exactly what the failing consumer experiences.
    param(
        [Parameter(Mandatory)][string]$ExecutableName,
        [Parameter()]$PathEntries,
        [Parameter()][string[]]$Extensions
    )

    if (-not $PathEntries) { return $null }
    if (-not $Extensions -or $Extensions.Count -eq 0) { $Extensions = @('.EXE') }

    $hasExplicitExtension = ($ExecutableName -match '\.[^\\/.]+$')

    foreach ($entry in $PathEntries) {
        if (-not $entry) { continue }
        if ($entry.IsEmpty) { continue }
        if ($entry.StillTokenized) { continue }

        $dir = [string]$entry.Expanded
        if ([string]::IsNullOrWhiteSpace($dir)) { continue }

        $candidates = New-Object System.Collections.Generic.List[string]
        if ($hasExplicitExtension) { $candidates.Add($ExecutableName) | Out-Null }
        foreach ($ext in $Extensions) {
            if ([string]::IsNullOrWhiteSpace($ext)) { continue }
            $candidates.Add($ExecutableName + $ext.Trim()) | Out-Null
        }

        foreach ($candidate in $candidates) {
            $full = $null
            try { $full = Join-Path -Path $dir -ChildPath $candidate } catch { continue }
            if ([string]::IsNullOrWhiteSpace($full)) { continue }
            try {
                if (Test-Path -LiteralPath $full -PathType Leaf) {
                    return [pscustomobject]@{ FullPath = $full; Directory = $dir; Entry = $entry }
                }
            }
            catch { }
        }
    }

    return $null
}

function Test-PowerShellExecutionProbe {
    # Launches the resolved powershell.exe once and confirms it returns a known exit code.
    #
    # This is the check that separates the two failure modes the agent cannot distinguish:
    #   - "not on PATH"            -> resolution fails (repairable here)
    #   - "on PATH but blocked"    -> resolution succeeds, execution fails or times out, which on
    #                                 these endpoints usually means ThreatLocker / SentinelOne /
    #                                 AppLocker interference and needs an allow rule, not a PATH fix.
    param(
        [Parameter(Mandatory)][string]$ExecutablePath,
        [int]$TimeoutMilliseconds = 20000
    )

    $result = [pscustomobject]@{
        Attempted   = $true
        Succeeded   = $false
        ExitCode    = $null
        TimedOut    = $false
        Error       = $null
        Interpretation = $null
    }

    $sentinel = 7
    $proc = $null
    try {
        $proc = Start-Process -FilePath $ExecutablePath `
                              -ArgumentList '-NoProfile', '-NonInteractive', '-Command', "exit $sentinel" `
                              -WindowStyle Hidden -PassThru -ErrorAction Stop

        if (-not $proc.WaitForExit($TimeoutMilliseconds)) {
            $result.TimedOut = $true
            try { $proc.Kill() } catch { }
            $result.Interpretation = 'PowerShell resolved but did not exit within the timeout. Suspect application control (ThreatLocker/SentinelOne/AppLocker) or a hung profile.'
            return $result
        }

        $result.ExitCode = $proc.ExitCode
        if ($proc.ExitCode -eq $sentinel) {
            $result.Succeeded = $true
            $result.Interpretation = 'PowerShell resolved and executed normally.'
        }
        else {
            $result.Interpretation = ("PowerShell resolved but returned {0} instead of the expected {1}. Suspect application control or a corrupted install." -f $proc.ExitCode, $sentinel)
        }
    }
    catch {
        $result.Error = $_.Exception.Message
        $result.Interpretation = 'PowerShell resolved on disk but could not be launched. This is an execution block, not a PATH problem; a PATH repair will not fix it.'
    }

    return $result
}

function Get-PowerShellPathDiagnostics {
    # IDENTIFY step. Read-only. Classifies why exec.LookPath("powershell") would fail on this host
    # and states whether a PATH/PATHEXT repair can actually fix it.
    param(
        [int]$LengthWarningThreshold = 2047,
        [bool]$RunExecutionProbe = $true
    )

    $findings = New-Object System.Collections.Generic.List[string]
    $warnings = New-Object System.Collections.Generic.List[string]

    $machinePath   = Get-MachineEnvironmentValueInfo -Name 'Path'
    $machinePathExt = Get-MachineEnvironmentValueInfo -Name 'PATHEXT'

    $machineEntries = Split-EnvironmentPathEntries -Value $machinePath.RawValue
    $processEntries = Split-EnvironmentPathEntries -Value $env:Path

    # PATHEXT as the consumer sees it. An absent machine PATHEXT still leaves the process one,
    # but the agent service gets the machine/SCM block, so the machine value is authoritative.
    $effectivePathExtRaw = if ($machinePathExt.Exists -and -not [string]::IsNullOrWhiteSpace($machinePathExt.ExpandedValue)) {
        [string]$machinePathExt.ExpandedValue
    } elseif (-not [string]::IsNullOrWhiteSpace($env:PATHEXT)) {
        [string]$env:PATHEXT
    } else { '' }

    $pathExtEntries = @()
    if (-not [string]::IsNullOrWhiteSpace($effectivePathExtRaw)) {
        $pathExtEntries = @($effectivePathExtRaw -split ';' | ForEach-Object { $_.Trim() } | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
    }
    $pathExtHasExe = (@($pathExtEntries | Where-Object { $_.ToUpperInvariant() -eq '.EXE' }).Count -gt 0)

    # Is the binary physically present, regardless of PATH? This is what decides repairable vs not.
    $expectedPsDirectory = Join-Path -Path $env:SystemRoot -ChildPath 'System32\WindowsPowerShell\v1.0'
    $expectedPsBinary    = Join-Path -Path $expectedPsDirectory -ChildPath 'powershell.exe'
    $binaryOnDisk        = $false
    try { $binaryOnDisk = Test-Path -LiteralPath $expectedPsBinary -PathType Leaf } catch { }

    # Resolve as the SERVICE would (machine Path) and as this process would.
    $extensionsForLookup = if ($pathExtHasExe) { $pathExtEntries } else { @('.EXE') }
    $machineResolution = Resolve-ExecutableFromPathEntries -ExecutableName 'powershell' -PathEntries $machineEntries -Extensions $extensionsForLookup
    $processResolution = Resolve-ExecutableFromPathEntries -ExecutableName 'powershell' -PathEntries $processEntries -Extensions $extensionsForLookup

    # --- Root cause classification -------------------------------------------------------------
    if (-not $machinePath.Exists) {
        $findings.Add('MachinePathMissing') | Out-Null
    }
    elseif ([string]::IsNullOrWhiteSpace($machinePath.RawValue)) {
        $findings.Add('MachinePathEmpty') | Out-Null
    }

    if ($machinePath.TokenUnexpanded) {
        $findings.Add('PathRegistryValueKindNotExpandable') | Out-Null
        $warnings.Add(("Machine Path is stored as {0} but contains %TOKEN% references. Windows will hand consumers the literal token text, making those directories unusable." -f $machinePath.ValueKind)) | Out-Null
    }

    if ($machinePath.ExpandedLength -ge $LengthWarningThreshold) {
        $findings.Add('MachinePathTruncationRisk') | Out-Null
        $warnings.Add(("Expanded machine Path is {0} characters (threshold {1}). Past this length the tail of Path is commonly ignored, which silently drops whichever directories sit at the end." -f $machinePath.ExpandedLength, $LengthWarningThreshold)) | Out-Null
    }

    if (-not $pathExtHasExe) {
        $findings.Add('PathExtMissingExe') | Out-Null
        $warnings.Add('PATHEXT does not contain .EXE. exec.LookPath is called with the bare name "powershell" and cannot extend it, so this alone reproduces the reported error even with a perfect Path.') | Out-Null
    }

    $system32Present = $false
    $psDirPresent    = $false
    $wantSystem32    = ConvertTo-ComparablePath (Join-Path $env:SystemRoot 'System32')
    $wantPsDir       = ConvertTo-ComparablePath $expectedPsDirectory
    foreach ($entry in $machineEntries) {
        if ($entry.IsEmpty) { continue }
        $cmp = ConvertTo-ComparablePath $entry.Unquoted
        if (-not $cmp) { continue }
        if ($cmp -eq $wantSystem32) { $system32Present = $true }
        if ($cmp -eq $wantPsDir)    { $psDirPresent = $true }
    }

    if (-not $system32Present) { $findings.Add('System32MissingFromMachinePath') | Out-Null }
    if (-not $psDirPresent)    { $findings.Add('PowerShellDirectoryMissingFromMachinePath') | Out-Null }

    if (-not $binaryOnDisk) {
        $findings.Add('PowerShellBinaryMissingOnDisk') | Out-Null
        $warnings.Add(("powershell.exe was not found at [{0}]. This is not a PATH problem and cannot be repaired by editing Path; the Windows PowerShell optional feature or the file itself is damaged/removed." -f $expectedPsBinary)) | Out-Null
    }

    if ($null -eq $machineResolution) { $findings.Add('UnresolvableFromMachinePath') | Out-Null }
    if ($null -eq $processResolution) { $findings.Add('UnresolvableFromProcessPath') | Out-Null }

    if ($null -ne $processResolution -and $null -eq $machineResolution) {
        $findings.Add('ProcessPathDivergesFromMachinePath') | Out-Null
        $warnings.Add('PowerShell resolves in this process but NOT from the machine Path. Interactive testing will look healthy while the agent service still fails, because the service is handed the machine environment.') | Out-Null
    }

    $emptyEntryCount  = @($machineEntries | Where-Object { $_.IsEmpty }).Count
    $quotedEntryCount = @($machineEntries | Where-Object { $_.WasQuoted }).Count
    if ($emptyEntryCount -gt 0)  { $findings.Add('MachinePathHasEmptyEntries') | Out-Null }
    if ($quotedEntryCount -gt 0) { $findings.Add('MachinePathHasQuotedEntries') | Out-Null }

    # --- Overall verdict -----------------------------------------------------------------------
    $healthy = ($null -ne $machineResolution) -and $pathExtHasExe -and -not $machinePath.TokenUnexpanded

    $repairable = $false
    $status     = 'Unknown'
    if ($healthy) {
        $status = 'Healthy'
    }
    elseif (-not $binaryOnDisk) {
        $status     = 'UnrepairableBinaryMissing'
        $repairable = $false
    }
    else {
        $status     = 'RepairablePathOrPathExt'
        $repairable = $true
    }

    # --- Optional execution probe ----------------------------------------------------------------
    $probe = $null
    $probeTarget = $null
    if ($machineResolution) { $probeTarget = $machineResolution.FullPath }
    elseif ($processResolution) { $probeTarget = $processResolution.FullPath }
    elseif ($binaryOnDisk) { $probeTarget = $expectedPsBinary }

    if ($RunExecutionProbe -and $probeTarget) {
        $probe = Test-PowerShellExecutionProbe -ExecutablePath $probeTarget
        if (-not $probe.Succeeded) {
            $findings.Add('PowerShellExecutionBlocked') | Out-Null
            $warnings.Add(("powershell.exe exists at [{0}] but did not execute cleanly: {1}" -f $probeTarget, $probe.Interpretation)) | Out-Null
            # An execution block is not fixed by a PATH repair. Say so explicitly rather than
            # letting a "repair succeeded" line imply the device is now healthy.
            if ($status -eq 'Healthy') { $status = 'ResolvedButExecutionBlocked'; $healthy = $false }
        }
    }

    return [pscustomobject]@{
        Status                  = $status
        Healthy                 = $healthy
        Repairable              = $repairable
        Findings                = (ConvertTo-SafeArray $findings)
        Warnings                = (ConvertTo-SafeArray $warnings)
        MachinePath             = $machinePath
        MachinePathExt          = $machinePathExt
        MachineEntries          = $machineEntries
        ProcessEntries          = $processEntries
        EffectivePathExt        = $effectivePathExtRaw
        PathExtHasExe           = $pathExtHasExe
        PathExtEntries          = $pathExtEntries
        ExpectedPsDirectory     = $expectedPsDirectory
        ExpectedPsBinary        = $expectedPsBinary
        BinaryOnDisk            = $binaryOnDisk
        System32OnMachinePath   = $system32Present
        PsDirectoryOnMachinePath = $psDirPresent
        ResolvedFromMachinePath = if ($machineResolution) { $machineResolution.FullPath } else { $null }
        ResolvedFromProcessPath = if ($processResolution) { $processResolution.FullPath } else { $null }
        EmptyEntryCount         = $emptyEntryCount
        QuotedEntryCount        = $quotedEntryCount
        ExecutionProbe          = $probe
    }
}

function Invoke-PowerShellPathRepair {
    # REPAIR step. Purely additive:
    #   - appends only the required directories that are genuinely absent
    #   - rewrites the value with the correct REG_EXPAND_SZ kind when that was the fault
    #   - repairs PATHEXT by appending .EXE (or restoring the Windows default when absent)
    #   - backs up the original raw values to $Folder first
    # Existing entries are never removed or reordered unless $NormalizeEntries is explicitly set.
    param(
        [Parameter(Mandatory)]$Diagnostics,
        [Parameter(Mandatory)][string]$TargetFolder,
        [bool]$RepairPath = $true,
        [bool]$RepairPathExtValue = $true,
        [bool]$NormalizeEntries = $false,
        [int]$LengthWarningThreshold = 2047
    )

    $result = [pscustomobject]@{
        Attempted          = $true
        PathChanged        = $false
        PathExtChanged     = $false
        EntriesAdded       = @()
        ValueKindCorrected = $false
        NormalizationApplied = $false
        PathBackupFile     = $null
        PathExtBackupFile  = $null
        NewMachinePathRaw  = $null
        NewPathExt         = $null
        Errors             = @()
        Warnings           = @()
    }

    $errors   = New-Object System.Collections.Generic.List[string]
    $warnings = New-Object System.Collections.Generic.List[string]
    $added    = New-Object System.Collections.Generic.List[string]

    # Token form is used for what we append so the value stays portable across SystemRoot layouts.
    $requiredTokens = @(
        '%SystemRoot%\system32',
        '%SystemRoot%',
        '%SystemRoot%\System32\Wbem',
        '%SystemRoot%\System32\WindowsPowerShell\v1.0\'
    )
    # If Path is already at the truncation threshold, only the two directories that make the agent
    # work at all are appended. Adding the nice-to-haves would push more of the tail out of range.
    $criticalTokens = @(
        '%SystemRoot%\system32',
        '%SystemRoot%\System32\WindowsPowerShell\v1.0\'
    )

    # ---------------- Path ----------------
    if ($RepairPath) {
        $mp = $Diagnostics.MachinePath

        $result.PathBackupFile = Backup-MachineEnvironmentValue -Name 'Path' -RawValue $mp.RawValue -TargetFolder $TargetFolder

        $existingComparable = New-Object System.Collections.Generic.HashSet[string]
        foreach ($entry in $Diagnostics.MachineEntries) {
            if ($entry.IsEmpty) { continue }
            $cmp = ConvertTo-ComparablePath $entry.Unquoted
            if ($cmp) { [void]$existingComparable.Add($cmp) }
        }

        $atLengthRisk = ($mp.ExpandedLength -ge $LengthWarningThreshold)
        $tokensToConsider = if ($atLengthRisk) {
            $warnings.Add('Machine Path is already at or beyond the truncation threshold; only the directories required for PowerShell resolution are being appended.') | Out-Null
            $criticalTokens
        } else { $requiredTokens }

        $missingTokens = New-Object System.Collections.Generic.List[string]
        foreach ($token in $tokensToConsider) {
            $cmp = ConvertTo-ComparablePath $token
            if (-not $cmp) { continue }
            if (-not $existingComparable.Contains($cmp)) {
                $missingTokens.Add($token) | Out-Null
                [void]$existingComparable.Add($cmp)
            }
        }

        # Rebuild the base value. Default keeps every original entry byte-for-byte.
        $baseEntries = New-Object System.Collections.Generic.List[string]
        foreach ($entry in $Diagnostics.MachineEntries) {
            if ($NormalizeEntries) {
                if ($entry.IsEmpty) { continue }
                $baseEntries.Add($entry.Unquoted) | Out-Null
            }
            else {
                $baseEntries.Add([string]$entry.Raw) | Out-Null
            }
        }
        if ($NormalizeEntries -and ($Diagnostics.EmptyEntryCount -gt 0 -or $Diagnostics.QuotedEntryCount -gt 0)) {
            $result.NormalizationApplied = $true
        }

        foreach ($token in $missingTokens) { $baseEntries.Add($token) | Out-Null }

        $newRaw = ((ConvertTo-SafeArray $baseEntries) -join ';')
        # Collapse only a trailing separator artifact; interior entries are untouched.
        $newRaw = $newRaw -replace ';+$', ''

        $needsKindFix  = $mp.TokenUnexpanded -or (-not $mp.IsExpandable -and $newRaw -match '%[^%]+%')
        $needsValueFix = ($missingTokens.Count -gt 0) -or $result.NormalizationApplied

        if ($needsValueFix -or $needsKindFix) {
            $write = Set-MachineEnvironmentValue -Name 'Path' -Value $newRaw -ValueKind 'ExpandString'
            if ($write.Success) {
                $result.PathChanged       = $true
                $result.NewMachinePathRaw = $newRaw
                $result.EntriesAdded      = (ConvertTo-SafeArray $missingTokens)
                $result.ValueKindCorrected = $needsKindFix
                foreach ($t in $missingTokens) { $added.Add($t) | Out-Null }
            }
            else {
                $errors.Add("Failed to write machine Path: $($write.Error)") | Out-Null
            }
        }
    }

    # ---------------- PATHEXT ----------------
    if ($RepairPathExtValue -and -not $Diagnostics.PathExtHasExe) {
        $pe = $Diagnostics.MachinePathExt
        $result.PathExtBackupFile = Backup-MachineEnvironmentValue -Name 'PATHEXT' -RawValue $pe.RawValue -TargetFolder $TargetFolder

        $newPathExt = $null
        if (-not $pe.Exists -or [string]::IsNullOrWhiteSpace($pe.RawValue)) {
            # Absent entirely: restore the Windows default set rather than inventing a minimal one.
            $newPathExt = $script:DefaultPathExt
        }
        else {
            # Present but missing .EXE: append it, keeping every existing extension and its order.
            $newPathExt = ($pe.RawValue.TrimEnd(';') + ';.EXE')
        }

        $write = Set-MachineEnvironmentValue -Name 'PATHEXT' -Value $newPathExt -ValueKind 'String'
        if ($write.Success) {
            $result.PathExtChanged = $true
            $result.NewPathExt     = $newPathExt
        }
        else {
            $errors.Add("Failed to write machine PATHEXT: $($write.Error)") | Out-Null
        }
    }

    $result.Errors   = (ConvertTo-SafeArray $errors)
    $result.Warnings = (ConvertTo-SafeArray $warnings)
    return $result
}

function Get-PresentLiongardServices {
    # Resolves the known Liongard service name variants to the ACTUAL service objects present on
    # this host. The real ServiceName (not the display name) is what indexes the registry key under
    # HKLM\SYSTEM\CurrentControlSet\Services, so it is captured here rather than guessed.
    $found = New-Object System.Collections.Generic.List[object]
    $seen  = New-Object System.Collections.Generic.HashSet[string]

    foreach ($candidate in (Get-LiongardServiceNames | Select-Object -Unique)) {
        $svc = Get-ServiceSafe -Name $candidate
        if (-not $svc) { continue }
        $realName = [string]$svc.Name
        if ([string]::IsNullOrWhiteSpace($realName)) { continue }
        if (-not $seen.Add($realName.ToUpperInvariant())) { continue }
        $found.Add([pscustomobject]@{
            ServiceName = $realName
            DisplayName = [string]$svc.DisplayName
            Status      = [string]$svc.Status
        }) | Out-Null
    }

    return (ConvertTo-SafeArray $found)
}

function Set-ServiceEnvironmentPathOverride {
    # Writes Path=<expanded> into the service's own REG_MULTI_SZ Environment value.
    #
    # This is what removes the reboot requirement. The Service Control Manager snapshots the system
    # environment block at boot, so a machine Path repair does not reach a service until the machine
    # restarts. SCM does, however, read each service's Environment value at service start and merge
    # it into that process. Writing a FULLY EXPANDED Path here means the agent gets a correct value
    # on the next service start regardless of the stale SCM block.
    #
    # Existing Environment entries other than Path= are preserved exactly.
    param(
        [Parameter(Mandatory)][string]$ServiceName,
        [Parameter(Mandatory)][string]$ExpandedPath
    )

    $key = $null
    try {
        $keyPath = "SYSTEM\CurrentControlSet\Services\$ServiceName"
        $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($keyPath, $true)
        if ($null -eq $key) {
            return [pscustomobject]@{ Success = $false; Error = "Service key HKLM\$keyPath could not be opened for write."; PreservedEntries = 0 }
        }

        $existing = @()
        try {
            $raw = $key.GetValue('Environment', $null)
            if ($raw) { $existing = @($raw) }
        }
        catch { }

        # Keep everything that is not a Path assignment; replace any existing Path= entry.
        $preserved = New-Object System.Collections.Generic.List[string]
        foreach ($item in $existing) {
            $line = [string]$item
            if ([string]::IsNullOrWhiteSpace($line)) { continue }
            if ($line -match '^\s*Path\s*=') { continue }
            $preserved.Add($line) | Out-Null
        }
        $preservedCount = $preserved.Count

        $preserved.Add(("Path={0}" -f $ExpandedPath)) | Out-Null

        $key.SetValue('Environment', (ConvertTo-SafeArray $preserved), [Microsoft.Win32.RegistryValueKind]::MultiString)
        return [pscustomobject]@{ Success = $true; Error = $null; PreservedEntries = $preservedCount }
    }
    catch {
        return [pscustomobject]@{ Success = $false; Error = $_.Exception.Message; PreservedEntries = 0 }
    }
    finally {
        if ($key) { try { $key.Close() } catch { } }
    }
}

function Restart-LiongardAgentService {
    # Restarts one Liongard service so it re-reads its environment. Falls back to an explicit
    # Stop/Start pair when Restart-Service fails, which happens on agents whose worker is wedged.
    param(
        [Parameter(Mandatory)][string]$ServiceName,
        [int]$StopTimeoutSeconds = 30
    )

    try {
        Restart-Service -Name $ServiceName -Force -ErrorAction Stop
        return [pscustomobject]@{ Success = $true; Method = 'Restart-Service'; Error = $null }
    }
    catch {
        $firstError = $_.Exception.Message
    }

    try {
        $svc = Get-ServiceSafe -Name $ServiceName
        if ($svc -and $svc.Status -ne 'Stopped') {
            Stop-Service -Name $ServiceName -Force -ErrorAction Stop
            try { $svc.WaitForStatus('Stopped', (New-TimeSpan -Seconds $StopTimeoutSeconds)) } catch { }
        }
        Start-Service -Name $ServiceName -ErrorAction Stop
        return [pscustomobject]@{ Success = $true; Method = 'Stop+Start'; Error = $null }
    }
    catch {
        return [pscustomobject]@{ Success = $false; Method = 'Stop+Start'; Error = ("Restart-Service failed ({0}); Stop/Start also failed ({1})." -f $firstError, $_.Exception.Message) }
    }
}

function Invoke-LiongardServicePathMitigation {
    # Applies the per-service Environment override and restarts the agent service so the corrected
    # PATH takes effect without a reboot. Idempotent and safe to call more than once per run: it is
    # invoked in Phase 7 for an already-installed agent, and again after a fresh install once the
    # service exists.
    param(
        [Parameter(Mandatory)][string]$ExpandedPath,
        [bool]$ApplyOverride = $true,
        [bool]$RestartService = $true
    )

    $result = [pscustomobject]@{
        ServicesFound     = 0
        OverridesApplied  = 0
        ServicesRestarted = 0
        RebootStillNeeded = $false
        Details           = @()
        Errors            = @()
    }

    $details = New-Object System.Collections.Generic.List[object]
    $errors  = New-Object System.Collections.Generic.List[string]

    $services = @(Get-PresentLiongardServices)
    $result.ServicesFound = $services.Count

    if ($services.Count -eq 0) {
        # Nothing installed yet. Not an error: the post-install hook calls this again.
        $result.Details = (ConvertTo-SafeArray $details)
        $result.Errors  = (ConvertTo-SafeArray $errors)
        return $result
    }

    foreach ($svc in $services) {
        $overrideApplied = $false
        $restarted       = $false
        $svcError        = $null

        if ($ApplyOverride) {
            $set = Set-ServiceEnvironmentPathOverride -ServiceName $svc.ServiceName -ExpandedPath $ExpandedPath
            if ($set.Success) {
                $overrideApplied = $true
                $result.OverridesApplied++
                Write-Host ("[PSPath] Service environment override written for '{0}' ({1} pre-existing entries preserved)." -f $svc.ServiceName, $set.PreservedEntries)
            }
            else {
                $svcError = $set.Error
                $errors.Add(("Service '{0}': {1}" -f $svc.ServiceName, $set.Error)) | Out-Null
            }
        }

        if ($RestartService) {
            $restart = Restart-LiongardAgentService -ServiceName $svc.ServiceName
            if ($restart.Success) {
                $restarted = $true
                $result.ServicesRestarted++
                Write-Host ("[PSPath] Service '{0}' restarted via {1}; corrected PATH is now in effect for the agent." -f $svc.ServiceName, $restart.Method)
            }
            else {
                $errors.Add(("Service '{0}' restart failed: {1}" -f $svc.ServiceName, $restart.Error)) | Out-Null
                Write-Warning ("[PSPath] Service '{0}' could not be restarted: {1}" -f $svc.ServiceName, $restart.Error)
            }
        }

        # A reboot is only genuinely required when neither delivery mechanism worked: no override
        # written AND no restart. Either one on its own gets the agent a correct PATH.
        if (-not $overrideApplied -and -not $restarted) { $result.RebootStillNeeded = $true }

        $details.Add([pscustomobject]@{
            ServiceName     = $svc.ServiceName
            DisplayName     = $svc.DisplayName
            StatusBefore    = $svc.Status
            OverrideApplied = $overrideApplied
            Restarted       = $restarted
            Error           = $svcError
        }) | Out-Null
    }

    $result.Details = (ConvertTo-SafeArray $details)
    $result.Errors  = (ConvertTo-SafeArray $errors)
    return $result
}

function Write-PowerShellPathReport {
    # Human-readable, greppable diagnostic block. Every line is prefixed [PSPath] so a fleet-wide
    # sweep can be filtered out of transcripts with a single search.
    param(
        [Parameter(Mandatory)]$Diagnostics,
        [Parameter()]$Repair,
        [Parameter()]$ServiceMitigation
    )

    $d = $Diagnostics
    Write-Host "=== PowerShell PATH Integrity (Phase 7) ==="
    Write-Host ("[PSPath] Status                    : {0}" -f $d.Status)
    Write-Host ("[PSPath] Healthy                   : {0}" -f $d.Healthy)
    Write-Host ("[PSPath] Repairable                : {0}" -f $d.Repairable)
    Write-Host ("[PSPath] Findings                  : {0}" -f $(if (@($d.Findings).Count -gt 0) { @($d.Findings) -join ', ' } else { '<none>' }))
    Write-Host ("[PSPath] powershell.exe on disk    : {0} ({1})" -f $d.BinaryOnDisk, $d.ExpectedPsBinary)
    Write-Host ("[PSPath] Resolved via machine Path : {0}" -f $(if ($d.ResolvedFromMachinePath) { $d.ResolvedFromMachinePath } else { '<UNRESOLVED>' }))
    Write-Host ("[PSPath] Resolved via process Path : {0}" -f $(if ($d.ResolvedFromProcessPath) { $d.ResolvedFromProcessPath } else { '<UNRESOLVED>' }))
    Write-Host ("[PSPath] Path registry value kind  : {0} (expandable={1}, tokens={2}, tokensBroken={3})" -f $d.MachinePath.ValueKind, $d.MachinePath.IsExpandable, $d.MachinePath.ContainsTokens, $d.MachinePath.TokenUnexpanded)
    Write-Host ("[PSPath] Path length raw/expanded  : {0} / {1}" -f $d.MachinePath.RawLength, $d.MachinePath.ExpandedLength)
    Write-Host ("[PSPath] System32 on machine Path  : {0}" -f $d.System32OnMachinePath)
    Write-Host ("[PSPath] PS v1.0 dir on Path       : {0}" -f $d.PsDirectoryOnMachinePath)
    Write-Host ("[PSPath] PATHEXT contains .EXE     : {0}" -f $d.PathExtHasExe)
    Write-Host ("[PSPath] PATHEXT effective         : {0}" -f $(if ($d.EffectivePathExt) { $d.EffectivePathExt } else { '<empty>' }))
    Write-Host ("[PSPath] Empty / quoted entries    : {0} / {1}" -f $d.EmptyEntryCount, $d.QuotedEntryCount)

    if ($d.ExecutionProbe) {
        Write-Host ("[PSPath] Execution probe           : succeeded={0}; exit={1}; timedOut={2}" -f $d.ExecutionProbe.Succeeded, $d.ExecutionProbe.ExitCode, $d.ExecutionProbe.TimedOut)
        Write-Host ("[PSPath] Execution probe verdict   : {0}" -f $d.ExecutionProbe.Interpretation)
    }

    foreach ($w in @($d.Warnings)) { Write-Warning ("[PSPath] {0}" -f $w) }

    if ($Repair) {
        Write-Host ("[PSPath] Repair - Path changed     : {0}" -f $Repair.PathChanged)
        Write-Host ("[PSPath] Repair - entries added    : {0}" -f $(if (@($Repair.EntriesAdded).Count -gt 0) { @($Repair.EntriesAdded) -join ' | ' } else { '<none>' }))
        Write-Host ("[PSPath] Repair - value kind fixed : {0}" -f $Repair.ValueKindCorrected)
        Write-Host ("[PSPath] Repair - PATHEXT changed  : {0}" -f $Repair.PathExtChanged)
        Write-Host ("[PSPath] Repair - Path backup      : {0}" -f $(if ($Repair.PathBackupFile) { $Repair.PathBackupFile } else { '<none>' }))
        Write-Host ("[PSPath] Repair - PATHEXT backup   : {0}" -f $(if ($Repair.PathExtBackupFile) { $Repair.PathExtBackupFile } else { '<none>' }))
        foreach ($w in @($Repair.Warnings)) { Write-Warning ("[PSPath] {0}" -f $w) }
        foreach ($e in @($Repair.Errors))   { Write-Warning ("[PSPath] Repair error: {0}" -f $e) }
    }

    if ($ServiceMitigation) {
        Write-Host ("[PSPath] Services found            : {0}" -f $ServiceMitigation.ServicesFound)
        Write-Host ("[PSPath] Service overrides applied : {0}" -f $ServiceMitigation.OverridesApplied)
        Write-Host ("[PSPath] Services restarted        : {0}" -f $ServiceMitigation.ServicesRestarted)
        Write-Host ("[PSPath] Reboot still required     : {0}" -f $ServiceMitigation.RebootStillNeeded)
        foreach ($e in @($ServiceMitigation.Errors)) { Write-Warning ("[PSPath] Service mitigation: {0}" -f $e) }
    }

    Write-Host "==========================================="
}

function Write-MsiRunSummary {
    # Writes a read-only JSON run summary (Phase 1; Phase 2 added exit-code fields;
    # Phase 7 added the PowerShell PATH diagnostic fields).
    # Idempotent: only the first call in a run writes the file.
    param([string]$Reason)

    if ($script:RunSummaryWritten) { return }
    if ([string]::IsNullOrWhiteSpace($script:SummaryArtifactPath)) { return }

    try {
        $summary = [ordered]@{
            scriptName                  = 'LGAgentScript_MSI'
            scriptType                  = 'MSI install'
            timestamp                   = (Get-Date).ToString('o')
            computerName                = $env:COMPUTERNAME
            executionIdentity           = ("{0}\{1}" -f $env:USERDOMAIN, $env:USERNAME)
            isElevated                  = $isElevated
            machineGuid                 = if ($deviceIdentity) { $deviceIdentity.MachineGuid } else { $null }
            hardwareUuid                = if ($deviceIdentity) { $deviceIdentity.HardwareUuid } else { $null }
            netbiosName                 = if ($deviceIdentity) { $deviceIdentity.NetbiosName } else { $env:COMPUTERNAME }
            hostname                    = if ($deviceIdentity) { $deviceIdentity.Hostname } else { $null }
            fqdn                        = if ($deviceIdentity) { $deviceIdentity.Fqdn } else { $null }
            macAddresses                = if ($deviceIdentity) { @($deviceIdentity.MacAddresses) } else { @() }
            agentDetected               = if ($detectionSnapshot) { ($detectionSnapshot.State -ne 'NotDetected') } else { $null }
            detectionState              = if ($detectionSnapshot) { $detectionSnapshot.State } else { $null }
            serviceStatuses             = if ($detectionSnapshot) { @($detectionSnapshot.Services | ForEach-Object { "$($_.Name)=$($_.Status)" }) } else { @() }
            installedVersion            = if ($installedVersion) { $installedVersion.ToString() } else { $null }
            installedAgentDetected      = if ($installInfo) { [bool]$installInfo.Installed } else { $null }
            installedVersionSource      = if ($installInfo) { $installInfo.VersionSource } else { $null }
            installedDetectionMethod    = if ($installInfo) { $installInfo.DetectionMethod } else { $null }
            installedProductCode        = if ($installInfo) { $installInfo.ProductCode } else { $null }
            installedUpgradeCode        = if ($installInfo) { $installInfo.UpgradeCode } else { $null }
            installedUninstallKeyPath   = if ($installInfo) { $installInfo.UninstallKeyPath } else { $null }
            installedVersionDetectionWarnings = if ($installInfo) { @($installInfo.Warnings) } else { @() }
            installerVersion            = if ($msiVersion) { $msiVersion.ToString() } else { $null }
            environmentInput            = $environmentInput
            environmentResolved         = $resolvedEnvironmentValue
            environmentResolutionReason = $script:EnvironmentResolutionReason
            decidedAction               = $decidedAction
            finalStatus                 = $finalStatus
            installerExitCode           = $exitCode
            scriptExitCode              = $script:ScriptExitCode
            scriptExitCodeMeaning       = if ($null -ne $script:ScriptExitCode) { Get-ScriptExitCodeMeaning -Code $script:ScriptExitCode } else { $null }
            rawInstallerExitCode        = if ($null -ne $msiExitCode) { $msiExitCode } else { $exitCode }
            rawInstallerExitCodeMeaning = if ($null -ne $msiExitCode) { Get-MsiResultText -Code $msiExitCode } elseif ($null -ne $exitCode) { Get-MsiResultText -Code $exitCode } else { $null }
            rebootRequired              = ($script:ScriptExitCode -eq 2)
            exitCodeStandardizedInPhase2 = $true
            standardAgentPath           = $true
            apiTokensRequired           = [bool]$apiFeatureEnabled
